# Copier en .env puis adapter. Aucune valeur réelle ne doit être commitée.
PORT=3000
NODE_ENV=development
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:4200
# PostgreSQL
DB_ENABLED=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sanjeevani
DB_USER=sanjeevani
DB_PASSWORD=change-me
DB_SSL=false
# Jamais synchronize=true en production : le schéma vient de migration/schema ou des migrations.
DB_SYNCHRONIZE=false
# JWT (même rôle que JwtTokenConfig côté .NET)
JWT_SECRET=change-me-with-a-long-random-string
JWT_ISSUER=sanjeevani
JWT_AUDIENCE=sanjeevani-web
JWT_VALID_MINUTES=480

# --- IAM (authentification) ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Redis : sessions et cache. Vide = mémoire (développement uniquement).
REDIS_URL=redis://:change-me@localhost:6379
# Mot de passe du service Redis de docker-compose (même valeur que dans REDIS_URL)
REDIS_PASSWORD=change-me
# 32 octets en base64 : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=
# Sel de l'ancien chiffrement .NET (migration des comptes hérités). Laisser vide pour désactiver.
LEGACY_PASSWORD_SALT=
COOKIE_SECURE=false
BREACH_CHECK_ENABLED=false

# --- Documentation de l'API ---
# /api-docs : page de connexion puis Swagger UI. Réservée aux comptes ayant la permission api.docs:read (administrateur
# système par défaut). Désactivée par défaut en production ; true en développement.
API_DOCS_ENABLED=true

# Fuseau horaire de l'établissement (nom IANA) : il décide du jour courant (affectations, départs).
TIME_ZONE=Africa/Douala

# Devise de l'installation (code ISO 4217) : les montants de la facturation sont des entiers dans sa plus petite unité (XAF : le franc CFA n'a pas de centimes).
BILLING_CURRENCY=XAF

# Écart de caisse (dans la plus petite unité de la devise) au-delà duquel la clôture attend la contre-signature d'un responsable.
BILLING_VARIANCE_LIMIT=5000

# --- Internationalisation ---
# Bibliothèque derrière le port Translator : nestjs-i18n (@nestjs/i18n) ou json (sans bibliothèque).
I18N_ADAPTER=nestjs-i18n
I18N_LOCALES=fr,en
I18N_DEFAULT_LOCALE=fr

# Remise (en % du sous-total d'une facture) au-delà de laquelle un responsable doit l'approuver ; 0 = toute remise, 100 = jamais.
BILLING_DISCOUNT_APPROVAL_PERCENT=10
