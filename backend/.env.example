# Copier en .env puis adapter. Aucune valeur réelle ne doit être commitée.
PORT=3000
NODE_ENV=development
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:4200
# PostgreSQL
DB_ENABLED=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sanjeevani
DB_USER=sanjeevani
DB_PASSWORD=change-me
DB_SSL=false
# Jamais synchronize=true en production : le schéma vient de migration/schema ou des migrations.
DB_SYNCHRONIZE=false
# JWT (même rôle que JwtTokenConfig côté .NET)
JWT_SECRET=change-me-with-a-long-random-string
JWT_ISSUER=sanjeevani
JWT_AUDIENCE=sanjeevani-web
JWT_VALID_MINUTES=480
