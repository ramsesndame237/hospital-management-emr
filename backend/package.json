{
  "name": "sanjeevani-api",
  "version": "0.1.0",
  "description": "API NestJS de Sanjeevani EMR (migration du backend ASP.NET Core / .NET Framework)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "inventory": "node tools/inventory-endpoints.mjs && node tools/inventory-sps.mjs && node tools/inventory-entities.mjs && node tools/generate-entities.mjs && node tools/report.mjs",
    "migration:report": "node tools/report.mjs",
    "db:iam": "node tools/apply-sql.mjs migration/schema/iam.pg.sql migration/schema/administration.pg.sql migration/schema/referentials.pg.sql migration/schema/staff.pg.sql migration/schema/patients.pg.sql migration/schema/appointments.pg.sql migration/schema/admissions.pg.sql migration/schema/billing.pg.sql migration/schema/lab.pg.sql",
    "iam:bootstrap-admin": "node dist/cli/bootstrap-admin.js",
    "playground": "node --require ts-node/register/transpile-only tools/playground.ts",
    "demo:dsi": "node tools/demo-dsi.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/i18n": "0.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "temporal-polyfill": "^1.0.6",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@nestjs/i18n": {
      "class-validator": "$class-validator"
    }
  }
}
