# Installation Docker Compose de Sanjeevani EMR : copier en `.env`, puis remplacer chaque « change-me ». Ne jamais commiter `.env`.
# (Le fichier backend/.env.example sert au développement de l'API sans Docker.)

# --- Secrets (obligatoires) ---
# Mot de passe de PostgreSQL et de Redis : longs et aléatoires, p. ex. `openssl rand -base64 24`
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Signature des jetons (32 caractères minimum) : `openssl rand -base64 48`
JWT_SECRET=change-me-with-a-long-random-string
# Clé AES-256 qui chiffre les secrets de double authentification : 32 octets en base64, `openssl rand -base64 32`.
# À CONSERVER avec les sauvegardes : sans elle, les comptes protégés par la double authentification ne se connectent plus.
SECRET_ENCRYPTION_KEY=

# --- Accès ---
# Port sur lequel l'interface web est publiée (mettre un reverse proxy TLS devant en production).
WEB_PORT=8080
# `true` en production (HTTPS). Les navigateurs acceptent aussi http://localhost.
COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:8080
# Documentation interactive de l'API (/api-docs, réservée à l'administrateur système) : true seulement pour une démonstration.
API_DOCS_ENABLED=false
# Vérification des mots de passe compromis (service HIBP, seuls 5 caractères du hachage SHA-1 sont envoyés). false pour un site sans accès Internet.
BREACH_CHECK_ENABLED=true

# --- Établissement ---
# Fuseau horaire (nom IANA) : il décide du jour courant pour l'agenda, les affectations et la caisse.
TIME_ZONE=Africa/Douala
# Devise (ISO 4217) : les montants sont des entiers dans sa plus petite unité (XAF : pas de centimes).
BILLING_CURRENCY=XAF
# Écart de caisse (plus petite unité) au-delà duquel la clôture attend la contre-signature d'un responsable.
BILLING_VARIANCE_LIMIT=5000
# Remise (en % du sous-total) au-delà de laquelle un responsable doit approuver.
BILLING_DISCOUNT_APPROVAL_PERCENT=10
# Un lot de médicaments qui périme dans ce nombre de jours est signalé « bientôt périmé ».
PHARMACY_EXPIRY_ALERT_DAYS=90
