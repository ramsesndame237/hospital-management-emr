<Project>
  <!--
    Provides .NET Framework 4.6.1 reference assemblies via NuGet instead of
    requiring the Developer Pack to be installed on the build machine. This
    keeps the solution buildable on CI agents / fresh machines that only
    have the .NET SDK (not a full Visual Studio "ASP.NET and web
    development" workload) without changing any project's own references.
  -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
